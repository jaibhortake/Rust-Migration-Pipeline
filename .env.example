# LLM: Groq first, local Ollama as fallback
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:4b

# Login (the server refuses to start without a password and a secret of 16+ random characters)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET=
# COOKIE_SECURE=true          # when served over HTTPS
# SESSION_MAX_AGE_S=43200

# Sandbox: docker (isolated, default) or local (NO isolation, development only)
# SANDBOX=docker
# MAX_CONCURRENT_JOBS=2
